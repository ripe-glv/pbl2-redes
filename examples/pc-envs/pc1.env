# PC 1
# Componentes neste PC:
# - broker-a
# - sensor-a-1
# - drone-base-1
# - drone 1
# - dashboard
#
# Edite os IPs somente neste bloco. Todas as URLs do Compose usam estas
# variaveis, entao trocar PC1_IP uma vez atualiza broker, drone e peers.

COMPOSE_PROFILES=pc1,dashboard

PC1_IP=172.16.103.7
PC2_IP=172.16.103.9
PC3_IP=172.16.103.10

DASHBOARD_PORT=8085

AREA_SIZE=20
ALERT_THRESHOLD=7
CLAIM_TTL_SECONDS=10
RETRY_SECONDS=3
MISSION_TIMEOUT_SECONDS=20
FAIL_RATE=0.12
MIN_MISSION_SECONDS=3
MAX_MISSION_SECONDS=8
