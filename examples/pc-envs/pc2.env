# PC 2
# Componentes neste PC:
# - broker-b
# - broker-c
# - sensor-b-1
# - sensor-c-1
# - drone-base-2
# - drone 2
#
# Edite os IPs somente neste bloco. Todas as URLs do Compose usam estas
# variaveis, entao trocar PC2_IP uma vez atualiza os dois brokers, sensores,
# drone e referencias dos outros componentes deste env.

COMPOSE_PROFILES=pc2

PC1_IP=172.16.103.8
PC2_IP=172.16.103.9
PC3_IP=172.16.103.10

AREA_SIZE=20
ALERT_THRESHOLD=7
CLAIM_TTL_SECONDS=10
RETRY_SECONDS=3
MISSION_TIMEOUT_SECONDS=20
FAIL_RATE=0.12
MIN_MISSION_SECONDS=3
MAX_MISSION_SECONDS=8
