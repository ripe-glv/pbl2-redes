# PC B: exemplo com outro broker, outra base de drone e um sensor local.
# Para mais brokers/drones no mesmo PC, rode novamente com outro --project-name
# e outro arquivo .env mudando IDs e portas publicadas.
BROKER_ID=broker-b
SECTOR_ID=area-2-central-route
BROKER_PORT=8002
PUBLIC_URL=http://192.168.0.20:8002
PEERS=http://192.168.0.10:8001,http://192.168.0.20:8003,http://192.168.0.20:8004,http://192.168.0.20:8005
DRONES=http://192.168.0.10:9001,http://192.168.0.20:9002,http://192.168.0.20:9003
AREA_X=48
AREA_Y=18

DRONE_ID=drone-base-2
BASE_ID=drone-base-2
DRONE_PORT=9002
BASE_X=52
BASE_Y=48

SENSOR_ID=sensor-b-1
SENSOR_SECTOR_ID=area-2-central-route
BROKER_URL=http://192.168.0.20:8002
INTERVAL_SECONDS=2.5
