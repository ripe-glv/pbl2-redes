# Modelo para docker-compose.distributed.yml
# Copie este arquivo para um novo .env, ajuste os valores e rode com:
# docker compose --env-file seu-arquivo.env -f docker-compose.distributed.yml --profile broker --profile drone --profile sensor up --build

# --------------------------------------------------------------------
# Identidade/endereco deste broker
# --------------------------------------------------------------------
BROKER_ID=broker-a
SECTOR_ID=area-1-north-route
BROKER_PORT=8001

# URL pela qual OUTROS computadores acessam este broker.
# Use o IP real da maquina na rede local, nao localhost.
PUBLIC_URL=http://192.168.0.10:8001

# Lista dos outros brokers do sistema, separados por virgula.
# Nao inclua o proprio broker aqui.
PEERS=http://192.168.0.20:8002,http://192.168.0.20:8003,http://192.168.0.20:8004,http://192.168.0.20:8005

# Lista de todas as bases de drones acessiveis na rede.
DRONES=http://192.168.0.10:9001,http://192.168.0.20:9002,http://192.168.0.20:9003

# Posicao visual do broker no dashboard.
AREA_X=18
AREA_Y=24

# Ajustes do broker.
ALERT_THRESHOLD=7
CLAIM_TTL_SECONDS=10
RETRY_SECONDS=3
MISSION_TIMEOUT_SECONDS=20

# --------------------------------------------------------------------
# Identidade/endereco da base de drone neste mesmo arquivo
# Use o profile drone somente se esta maquina for rodar uma base.
# --------------------------------------------------------------------
DRONE_ID=drone-base-1
BASE_ID=drone-base-1
DRONE_PORT=9001

# Posicao visual da base no dashboard.
BASE_X=24
BASE_Y=48

# Comportamento da missao.
FAIL_RATE=0.12
MIN_MISSION_SECONDS=3
MAX_MISSION_SECONDS=8

# --------------------------------------------------------------------
# Sensor local
# Use o profile sensor somente se esta maquina for rodar um sensor.
# --------------------------------------------------------------------
SENSOR_ID=sensor-a-1
SENSOR_SECTOR_ID=area-1-north-route

# Broker para onde este sensor envia eventos.
BROKER_URL=http://192.168.0.10:8001
INTERVAL_SECONDS=2

# --------------------------------------------------------------------
# Dashboard
# Use o profile dashboard somente se esta maquina for servir a interface.
# A lista de brokers/drones mostrada na tela fica em dashboard/config.js.
# --------------------------------------------------------------------
DASHBOARD_PORT=8080
